# ─────────────────────────────────────────────────────────────────────────────
# DINAMYT — Backend · variables de entorno (EJEMPLO)
#
# Copia este archivo a `.env` y ajusta los valores.  El `.env` real NO se sube
# a git (está en .gitignore).  En producción (Render) estas variables se
# definen en el panel del servicio, no en un archivo.
# ─────────────────────────────────────────────────────────────────────────────

# Entorno: "development" (local, SQLite) o "production" (Render, PostgreSQL).
FLASK_ENV=development

# Puerto del backend (local). Render inyecta su propio $PORT.
PORT=5000

# Base de datos.
#   · Local: deja esto vacío/omítelo → usa SQLite (backend/instance/dinamyt.db).
#   · Producción: connection string de Neon/Supabase (PostgreSQL).
# DATABASE_URL=postgresql://usuario:password@host/dbname

# Clave para firmar los JWT. GENERA UNA PROPIA para producción con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# El backend se NIEGA a arrancar en producción si es débil o vacía.
JWT_SECRET_KEY=CAMBIAR-POR-UN-VALOR-ALEATORIO-LARGO

# Origen(es) permitido(s) para CORS. En producción: tu URL EXACTA de Vercel
# (con https:// y sin "/" final). Acepta varias separadas por coma.
FRONTEND_URL=http://localhost:3000

# Admin inicial (se crea/actualiza en el primer arranque).
# OBLIGATORIA: sin ella el seed no crea el admin (no hay valor por defecto,
# para que ninguna contraseña viva en el código). Usa 12+ caracteres.
ADMIN_EMAIL=admin@dinamyt.org
ADMIN_PASSWORD=CAMBIAR-POR-UNA-CONTRASENA-FUERTE
ADMIN_NOMBRE=Administrador DINAMYT

# Proxies de confianza delante del backend. 0 en la LAN (ahí X-Forwarded-For
# lo puede falsear cualquiera); 1 detrás de Render. En producción vale 1 salvo
# que se defina otra cosa aquí.
TRUST_PROXY_HOPS=0

# ── Cookie de sesión ─────────────────────────────────────────────────────────
# El token va en una cookie httpOnly, no en localStorage: así un script
# inyectado en la página no puede leerlo.
#
# En la LAN el frontend (3000) y el backend (5000) están en el mismo host, así
# que "Lax" funciona tal cual. Solo hace falta "None" si algún día se sirven
# desde dominios distintos — y ahí Safari bloquea la cookie por ser de
# terceros, así que lo sano es mantenerlos juntos.
COOKIE_SAMESITE=Lax
# "None" fuerza Secure por su cuenta. Ponlo en true si sirves por HTTPS.
COOKIE_SECURE=false

# Costo de bcrypt para el hash de contraseñas (rondas). 10 = rápido y seguro.
BCRYPT_ROUNDS=10

# Respaldo automático de la BD local cada N minutos (0 = desactivado).
# Solo aplica al despliegue local; en Render/Neon no se usa.
RESPALDO_MINUTOS=10
